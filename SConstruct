env = Environment(
    tools=['default', 'compilation_db'],
    CC='clang',
    CXX='clang++'
)

env.Append(
    CCFLAGS=['-O2', '-Wall'],
    CXXFLAGS=['-std=c++17']
)

env.Append(CPPPATH=[
    'src',
    'thirdparty/glm',
    'thirdparty/glfw/include',
    'thirdparty/imgui',
    'thirdparty/imgui/backends',
    'thirdparty/glslang',
    'thirdparty/glslang/glslang',
    'thirdparty/glslang/SPIRV',
    'thirdparty/spirv-cross'
])

env.Append(
    LIBPATH=[
        'thirdparty/glfw/build/src'
    ],
    LIBS=[
        'glfw3'
    ]
)

