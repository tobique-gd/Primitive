build_info = env.Command(
    'thirdparty/glslang/glslang/build_info.h',
    [
        'thirdparty/glslang/build_info.py',
        'thirdparty/glslang/build_info.h.tmpl'
    ],
    'python3 thirdparty/glslang/build_info.py '
    'thirdparty/glslang '
    '-i thirdparty/glslang/build_info.h.tmpl '
    '-o $TARGET'
)

env.Depends(source_files, build_info)

if env['PLATFORM'] == 'darwin':

    env.Append(
        CPPDEFINES=[
            'IMGUI_IMPL_METAL_CPP'
        ],
        CPPPATH=[
            'thirdparty/metal-cpp'
        ],
        FRAMEWORKS=[
            'Cocoa',
            'IOKit',
            'CoreVideo',
            'Metal',
            'QuartzCore'
        ]
    )

    source_files += [
        'thirdparty/imgui/backends/imgui_impl_metal.mm'
    ]

    source_files += Glob(
        'src/renderer/metal/*'
    )

else:
    source_files += [
        'thirdparty/imgui/backends/imgui_impl_vulkan.cpp'
    ]

    source_files += Glob(
        'src/renderer/vulkan/*'
    )

    if env['PLATFORM'] == 'win32':
        env.Append(
            LIBS=[
                'vulkan-1'
            ]
        )
    else:
        env.ParseConfig(
            'pkg-config --cflags --libs vulkan'
        )

compilation_db = env.CompilationDatabase(
    'compile_commands.json'
)

env.Program(
    target='Editor',
    source=source_files
)
